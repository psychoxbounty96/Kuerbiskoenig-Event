-- Run once after deploying `minion-tick` and storing the URL/key in Vault.
-- Supabase Cron accepts interval schedules; this keeps server-time transitions responsive.
select cron.schedule(
  'kuerbiskoenig-minion-tick',
  '10 seconds',
  $$
    select net.http_post(
      url := (select decrypted_secret from vault.decrypted_secrets where name = 'project_url') || '/functions/v1/minion-tick',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'Authorization', 'Bearer ' || (select decrypted_secret from vault.decrypted_secrets where name = 'service_role_key')
      ),
      body := '{}'::jsonb
    );
  $$
);
