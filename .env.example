# Local Vite preview defaults to mock when VITE_DATA_PROVIDER is omitted.
VITE_DATA_PROVIDER=mock
VITE_EVENT_SLUG=halloween-2026-test
VITE_OVERLAY_STREAMER=nachtfalter

# Browser-safe values used by the GitHub Pages build.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_BASE_PATH=/YOUR_GITHUB_REPOSITORY/

# Supabase automatically provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# inside hosted Edge Functions. Do not create or commit them yourself.
PASSIVE_TICK_ENABLED=false

# Edge Functions only. Set these through Supabase Edge Function Secrets.
TWITCH_CLIENT_ID=REPLACE_IN_SUPABASE_SECRETS
TWITCH_CLIENT_SECRET=REPLACE_IN_SUPABASE_SECRETS
TWITCH_EVENTSUB_SECRET=REPLACE_WITH_10_TO_100_RANDOM_CHARACTERS
TWITCH_EVENTSUB_CALLBACK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/twitch-eventsub
MINION_PARTICIPANT_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
